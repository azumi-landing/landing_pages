---
import PageLayout from '../layouts/PageLayout.astro';
import ContactStrip from '../components/sections/ContactStrip.astro';
import { technologySections } from '../data/technology';
import { buildBreadcrumbSchema } from '../data/site';
---

<PageLayout
  title="Tecnología | Ingeniería de datos e inteligencia artificial — Héctor Guerra"
  description="Conocé las capacidades de datos, inteligencia artificial e ingeniería que permiten integrar, desplegar y sostener soluciones para tu empresa."
  path="/tecnologia"
  schemas={[buildBreadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Tecnología', path: '/tecnologia' }
  ])]}
>
  <main aria-labelledby="technology-title">
    <section class="section-shell-hero section-deep">
      <div class="page-container">
        <p class="section-eyebrow text-cyan-300">Tecnología / De la idea al uso real</p>
        <h1 id="technology-title" class="text-4xl md:text-6xl font-bold leading-tight max-w-4xl mb-7">
          La tecnología detrás<br />de cada solución.
        </h1>
        <p class="text-xl text-slate-300 leading-relaxed max-w-3xl">
          Conecto datos, modelos y sistemas según lo que tu empresa necesita.
          Estas son las capacidades que permiten llevar una idea a la práctica.
        </p>
      </div>
    </section>

    {technologySections.map((section, index) => (
      <section
        id={section.id}
        aria-labelledby={`${section.id}-title`}
        class:list={['section-shell', index === 1 ? 'section-muted' : 'section-light']}
      >
        <div class="page-container">
          <div class="grid gap-8 lg:grid-cols-[1.1fr_.9fr] lg:gap-16 items-start">
            <div>
              <p class="section-eyebrow text-blue-700">{section.number} / Capacidad técnica</p>
              <h2 id={`${section.id}-title`} class="section-title">{section.title}</h2>
              <p class="section-copy text-slate-600">{section.description}</p>
            </div>
            <aside class="border-l-2 border-blue-700 pl-6 lg:mt-10" aria-label={`Ejemplo de aplicación: ${section.title}`}>
              <p class="text-sm font-semibold text-blue-700 mb-3">Una aplicación posible</p>
              <p class="text-lg text-slate-700 leading-relaxed">{section.example}</p>
            </aside>
          </div>

          <details class="surface-card surface-panel mt-9">
            <summary class="cursor-pointer p-6 font-semibold text-slate-950">
              Explorar capacidades técnicas<span class="sr-only">: {section.title}</span>
            </summary>
            <div class="grid gap-8 px-6 pb-8 md:px-8 lg:grid-cols-3">
              {section.groups.map((group) => (
                <div class="border-t border-slate-200 pt-5">
                  <h3 class="text-lg font-bold text-slate-950 mb-4">{group.title}</h3>
                  <ul class="space-y-4 text-base leading-relaxed text-slate-600">
                    {group.items.map((item) => (
                      <li class="flex gap-3">
                        <span class="text-blue-700 shrink-0" aria-hidden="true">→</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        </div>
      </section>
    ))}

    <ContactStrip
      originPath="/tecnologia"
      service="otro"
      title="La capacidad técnica empieza por entender qué necesitás resolver."
      description="Contame tu desafío. Revisamos qué capacidades hacen falta y qué camino tiene sentido, sin elegir herramientas antes de entender el problema."
      ctaLabel="Conversemos sobre lo que necesitás construir"
    />
  </main>
</PageLayout>
