---
import '../styles/global.css';
import '../styles/ispCampaign.css';
import SeoHead from '../components/SeoHead.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import IspSlide from '../components/sections/IspSlide.astro';
import { ispProblems, ispConsequences, ispSolutions, ispMeeting, ispCtaLabel } from '../data/ispCampaign';
import { buildServiceSchema } from '../data/site';

const title = 'Software e ingeniería de datos para ISPs en Honduras | HGuerra';
const description = 'Integro datos y automatizo procesos para dar seguimiento a clientes, coordinar instalaciones y priorizar fallas de tu ISP. Sistemas actuales y soluciones a medida.';
const total = 5;
const videoUrl = 'https://www.youtube.com/shorts/LNKeNj_uYgU';
---

<!doctype html>
<html lang="es" class="isp-campaign">
  <head>
    <SeoHead title={title} description={description} path="/isp-honduras"
      schemas={[buildServiceSchema({ name: 'Desarrollo de software e ingeniería de datos para ISPs', description, path: '/isp-honduras', areaServed: 'Honduras' })]} />
  </head>
  <body class="page-body-light isp-deck">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <main id="contenido" tabindex="-1">
      <IspSlide id="introduccion" index={0} total={total} label="Para ISPs de Honduras" tone="dark" titleId="isp-title" class="hero-slide">
        <div class="hero-layout">
          <div class="slide-copy">
            <p class="hero-eyebrow">Software a medida · Datos · Automatización</p>
            <h1 id="isp-title">¿En tu ISP cuesta dar seguimiento a clientes, coordinar instalaciones o <span>priorizar fallas?</span></h1>
            <p class="slide-lead">Integro datos y automatizo procesos, aprovechando tus sistemas actuales o desarrollando <strong>soluciones a medida</strong>.</p>
            <a href="/isp-honduras#conversemos" class="campaign-cta">{ispCtaLabel} <span aria-hidden="true">↗</span></a>
            <p class="hero-note">Agendemos una reunión breve para conocer qué necesitás mejorar.</p>
          </div>
          <div class="hero-video">
            <div class="video-frame" id="isp-video">
              <a class="video-poster" href={videoUrl} target="_blank" rel="noopener noreferrer" data-load-isp-video aria-label="Ver video: software a medida y automatización para tu ISP" aria-describedby="video-privacy">
                <img src="/images/isp/video-poster.jpg" alt="" width="1280" height="720" fetchpriority="high" />
                <span class="video-play"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m9 5 11 7-11 7V5Z" /></svg></span>
                <span class="video-caption">Ver video</span>
              </a>
            </div>
            <p class="video-privacy" id="video-privacy">Al activar el video, se carga YouTube y se comparten datos técnicos con Google. <a href="/privacidad#videos">Privacidad</a>.</p>
            <a class="video-external" href={videoUrl} target="_blank" rel="noopener noreferrer">Ver directamente en YouTube <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <span slot="footer">Héctor Guerra · Consultoría + implementación + acompañamiento</span>
      </IspSlide>

      <IspSlide id="problemas" index={1} total={total} label="El problema" tone="dark" titleId="problems-title">
        <div class="scene-intro">
          <h2 id="problems-title">Cuando la información está dispersa, <span>dar seguimiento cuesta más.</span></h2>
          <p class="slide-lead">Clientes, instalaciones y fallas necesitan contexto, responsables y un siguiente paso claro.</p>
        </div>
        <div class="illustrated-grid">
          {ispProblems.map((problem) => (
            <article class="illustrated-item" id={problem.id}>
              <img src={problem.image.src} alt={problem.image.alt} width={problem.image.width} height={problem.image.height} loading="lazy" decoding="async" />
              <div class="item-copy"><h3>{problem.title}</h3><p>{problem.description}</p></div>
            </article>
          ))}
        </div>
        <span slot="footer">¿Reconocés alguna de estas situaciones en tu equipo?</span>
      </IspSlide>

      <IspSlide id="consecuencias" index={2} total={total} label="Lo que está en juego" tone="dark" titleId="consequences-title">
        <div class="scene-intro">
          <h2 id="consequences-title">Lo pendiente puede convertirse en <span>cancelaciones, cobros sin resolver y más reclamos.</span></h2>
          <p class="slide-lead">Cuando el seguimiento se interrumpe, el equipo dedica tiempo a reconstruir casos y el cliente sigue esperando.</p>
        </div>
        <div class="illustrated-grid">
          {ispConsequences.map((item) => (
            <article class="illustrated-item">
              <img src={item.image.src} alt={item.image.alt} width={item.image.width} height={item.image.height} loading="lazy" decoding="async" />
              <div class="item-copy"><h3>{item.title}</h3><p>{item.description}</p></div>
            </article>
          ))}
        </div>
        <a slot="footer" href="#solucion" class="slide-text-cta">Cómo puedo ayudarte <span aria-hidden="true">↓</span></a>
      </IspSlide>

      <IspSlide id="solucion" index={3} total={total} label="Cómo puedo ayudarte" tone="dark" titleId="solution-title">
        <div class="scene-intro">
          <h2 id="solution-title">Conecto lo que ya tenés y <span>desarrollo lo que hace falta.</span></h2>
          <p class="slide-lead">Partimos del proceso que necesitás mejorar para construir una solución que tu equipo pueda usar.</p>
        </div>
        <div class="solution-grid">
          {ispSolutions.map((solution) => (
            <article class="solution-item">
              <img src={solution.image.src} alt={solution.image.alt} width={solution.image.width} height={solution.image.height} loading="lazy" decoding="async" />
              <div class="item-copy">
                <h3>{solution.title}</h3>
                <ul>{solution.details.map((detail) => <li>{detail}</li>)}</ul>
              </div>
            </article>
          ))}
        </div>
        <p class="solution-principle">Empezamos por una necesidad concreta. <strong>No hace falta reemplazar todos tus sistemas ni incorporar IA si no aporta valor.</strong></p>
        <p class="slide-note">La viabilidad depende de los accesos e interfaces disponibles. Acordamos permisos y trazabilidad; las herramientas de monitoreo no incluyen operar tu red 24/7.</p>
        <a slot="footer" href="#conversemos" class="slide-text-cta">{ispCtaLabel} <span aria-hidden="true">↗</span></a>
      </IspSlide>

      <IspSlide id="conversemos" index={4} total={total} label="Una primera conversación" tone="dark" titleId="contact-title">
        <div class="contact-layout">
          <div class="contact-copy">
            <h2 id="contact-title">Conversemos sobre tu ISP. <span>Agendemos una reunión breve.</span></h2>
            <p class="slide-lead">Contame qué está costando resolver. Revisamos tus sistemas actuales y evaluamos una primera solución con alcance claro.</p>
            <img class="meeting-illustration" src={ispMeeting.src} alt={ispMeeting.alt} width={ispMeeting.width} height={ispMeeting.height} loading="lazy" decoding="async" />
            <div class="profile">
              <img src="/mi_foto_pro.jpeg" alt="Héctor Guerra" width="72" height="72" loading="lazy" decoding="async" />
              <div><strong>Héctor Guerra</strong><p>Ingeniero Electricista Industrial · Tegucigalpa, Honduras.<br />Trabajo directamente con vos, desde entender la necesidad hasta implementar y transferir la solución.</p></div>
            </div>
          </div>
          <div class="contact-panel">
            <h3>Coordinemos la reunión</h3>
            <p class="form-intro">Dejame tu correo y contame qué necesitás mejorar. Te contacto para coordinar.</p>
            <ContactForm originPath="/isp-honduras" tone="light" defaultService="otro" showService={false} detailPlaceholder="Represento a [nombre del ISP]. Queremos mejorar… Hoy usamos… Podemos conversar…" submitLabel="Coordinar una reunión breve" />
            <p class="contact-terms">Si avanzamos, acordamos entrega, alcance, inversión y plazos antes de iniciar. La consulta no es una contratación ni incluye un diagnóstico completo gratuito.</p>
          </div>
        </div>
      </IspSlide>
    </main>
    <nav class="slide-navigation" aria-label="Navegación entre diapositivas" hidden>
      <button type="button" data-slide-direction="-1" aria-label="Diapositiva anterior" aria-disabled="true">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <span class="navigation-position" aria-label="Diapositiva actual">01 / {total}</span>
      <button type="button" data-slide-direction="1" aria-label="Diapositiva siguiente">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14m-6-6 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </nav>
    <footer class="campaign-footer"><div class="legal-inner"><p><strong>HGuerra</strong> · Inteligencia aplicada a desafíos reales.</p><div><a href="/privacidad">Privacidad</a><a href="/terminos">Términos</a></div></div></footer>
    <AnalyticsConsent enabled={true} />
    <script>
      const videoFrame = document.querySelector<HTMLElement>('#isp-video')!;
      const videoTrigger = videoFrame.querySelector<HTMLAnchorElement>('[data-load-isp-video]')!;
      const videoButton = document.createElement('button');
      videoButton.type = 'button';
      videoButton.className = videoTrigger.className;
      videoButton.setAttribute('aria-label', 'Reproducir video: software a medida y automatización para tu ISP');
      videoButton.setAttribute('aria-describedby', 'video-privacy');
      videoButton.append(...videoTrigger.childNodes);
      videoTrigger.replaceWith(videoButton);

      videoButton.addEventListener('click', () => {
        // No iframe, remote thumbnail or YouTube SDK is loaded before this gesture.
        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube-nocookie.com/embed/LNKeNj_uYgU?autoplay=1&playsinline=1&rel=0&hl=es';
        iframe.title = 'Software a medida y automatización para ISP en Honduras — HGuerra';
        iframe.width = '360';
        iframe.height = '640';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        videoFrame.replaceChildren(iframe);
        iframe.focus();
      }, { once: true });
    </script>
    <script>
      const navigation = document.querySelector<HTMLElement>('.slide-navigation')!;
      const slides = [...document.querySelectorAll<HTMLElement>('.isp-slide')];
      const previous = navigation.querySelector<HTMLButtonElement>('[data-slide-direction="-1"]')!;
      const next = navigation.querySelector<HTMLButtonElement>('[data-slide-direction="1"]')!;
      const position = navigation.querySelector<HTMLElement>('.navigation-position')!;
      let current = 0;
      let observer: IntersectionObserver;

      function updateNavigation() {
        const marker = window.innerHeight * .25;
        current = 0;
        for (let index = 1; index < slides.length; index++) {
          if (slides[index].getBoundingClientRect().top > marker) break;
          current = index;
        }
        previous.setAttribute('aria-disabled', String(current === 0));
        next.setAttribute('aria-disabled', String(current === slides.length - 1));
        previous.setAttribute('aria-controls', slides[Math.max(0, current - 1)].id);
        next.setAttribute('aria-controls', slides[Math.min(slides.length - 1, current + 1)].id);
        position.textContent = `${String(current + 1).padStart(2, '0')} / ${slides.length}`;
      }

      function observeSlides() {
        observer?.disconnect();
        // A one-pixel band tracks the section being read, including tall slides.
        const marker = Math.round(window.innerHeight * .25);
        observer = new IntersectionObserver(updateNavigation, {
          rootMargin: `-${marker}px 0px -${window.innerHeight - marker - 1}px 0px`,
          threshold: 0
        });
        slides.forEach((slide) => observer.observe(slide));
        updateNavigation();
      }

      navigation.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('button[data-slide-direction]');
        if (!button) return;
        updateNavigation();
        const destination = current + Number(button.dataset.slideDirection);
        if (destination < 0 || destination >= slides.length) return;
        // Jump immediately so repeated presses never wait for a scroll animation.
        slides[destination].scrollIntoView({ behavior: 'instant', block: 'start' });
        updateNavigation();
      });
      window.addEventListener('resize', observeSlides);
      document.body.classList.add('has-slide-navigation');
      navigation.hidden = false;
      observeSlides();
    </script>
  </body>
</html>
