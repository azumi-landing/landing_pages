---
import '../styles/global.css';
import '../styles/ispCampaign.css';
import SeoHead from '../components/SeoHead.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import IspSlide from '../components/sections/IspSlide.astro';
import IspAreaScene from '../components/sections/IspAreaScene.astro';
import IspEngineering from '../components/sections/IspEngineering.astro';
import { ispScenarios, ispFaqs, ispCtaLabel, ispIllustrations } from '../data/ispCampaign';
import { buildFAQSchema, buildServiceSchema } from '../data/site';

const title = 'Software e ingeniería de datos para ISPs en Honduras | HGuerra';
const description = 'Aplicaciones, integraciones, análisis y automatización para conectar clientes, operación y monitoreo de tu ISP. Conversemos sobre una primera solución con alcance acordado.';
const total = 10;
const hero = ispIllustrations.introduccion;
const method = ispIllustrations['forma-de-trabajo'];
---

<!doctype html>
<html lang="es" class="isp-campaign">
  <head>
    <SeoHead title={title} description={description} path="/isp-honduras"
      schemas={[buildFAQSchema(ispFaqs), buildServiceSchema({ name: 'Desarrollo de software e ingeniería de datos para ISPs', description, path: '/isp-honduras', areaServed: 'Honduras' })]} />
  </head>
  <body class="page-body-light isp-deck">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <main id="contenido" tabindex="-1">
      <IspSlide id="introduccion" index={0} total={total} label="Para ISPs de Honduras" tone="dark" titleId="isp-title">
        <div class="split-slide">
          <div class="slide-copy">
            <p class="hero-eyebrow">Software e ingeniería de datos para ISPs de Honduras.</p>
            <h1 id="isp-title">¿Qué problemas están frenando <span>el crecimiento de tu ISP?</span></h1>
            <p class="slide-lead">Clientes que cancelan, procesos manuales y sistemas desconectados dificultan el crecimiento y el control de tu negocio.</p>
            <p class="slide-lead"><strong>Cada ISP tiene desafíos diferentes. La solución comienza por entenderlos.</strong></p>
            <p class="slide-lead">En HGuerra.com diseño e implemento soluciones a medida con <strong>software personalizado, ingeniería de datos y agentes de inteligencia artificial</strong>.</p>
            <a href="/isp-honduras#conversemos" class="campaign-cta">{ispCtaLabel} <span aria-hidden="true">↗</span></a>
            <p class="hero-note">Cuéntame qué necesitas mejorar y evaluemos una primera solución.</p>
          </div>
          <figure class="isp-illustration hero-visual">
            <img src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} fetchpriority="high" />
          </figure>
        </div>
        <span slot="footer">Héctor Guerra · Consultoría + implementación + acompañamiento</span>
      </IspSlide>

      {ispScenarios.map((scenario, index) => (
        <IspSlide id={scenario.id} index={index + 1} total={total} label={scenario.area}
          tone={index === 1 ? 'muted' : 'light'} titleId={`scenario-${scenario.id}`} class="area-slide">
          <div class="split-slide">
            {scenario.id === 'operativa' && <IspAreaScene area={scenario.id} illustration={scenario.illustration} />}
            <div class="slide-copy scenario-copy">
              <h2 id={`scenario-${scenario.id}`}>{scenario.title}</h2>
              <p class="scenario-problem">{scenario.problem}</p>
              <p class="scenario-problem">{scenario.consequence}</p>
              <div class="scenario-solution">
                <h3>Cómo puedo ayudarte</h3>
                <p>{typeof scenario.solution === 'string' ? scenario.solution : <>{scenario.solution.before}<strong>{scenario.solution.emphasis}</strong>{scenario.solution.after}</>}</p>
              </div>
              <p class="scenario-delivery"><strong>Qué recibe tu equipo:</strong> {scenario.deliverable}</p>
              <p class="scenario-benefit"><strong>Para qué le sirve:</strong> {scenario.benefit}</p>
              <p class="related-solutions"><strong>{scenario.relatedSolutions.join(' · ')}</strong></p>
              <a href="/isp-honduras#conversemos" class="campaign-cta">{ispCtaLabel} <span aria-hidden="true">↗</span></a>
            </div>
            {scenario.id !== 'operativa' && <IspAreaScene area={scenario.id} illustration={scenario.illustration} />}
          </div>
          <span slot="footer">Una solución posible, no un diagnóstico de tu ISP ni resultados garantizados.</span>
        </IspSlide>
      ))}

      <IspSlide id="forma-de-trabajo" index={4} total={total} label="Cómo trabajo" tone="dark" titleId="method-title" class="method-slide">
        <div class="split-slide">
          <div class="slide-copy scenario-copy">
            <h2 id="method-title">¿Tenés mejoras pendientes y no sabés por dónde empezar?</h2>
            <p class="scenario-problem">Sin una prioridad clara, las mejoras pueden quedarse en ideas o cambios que no resuelven el problema.</p>
            <ol class="method-steps">
              <li><h3>Entender</h3><p>Revisamos tu proceso y elegimos qué mejorar primero.</p></li>
              <li><h3>Construir e integrar</h3><p>Aprovecho lo que funciona y desarrollo lo que falta.</p></li>
              <li><h3>Acompañar</h3><p>Transfiero el uso y acordamos cómo sostener la solución.</p></li>
            </ol>
            <p class="scenario-delivery"><strong>Qué recibe tu equipo:</strong> una primera solución utilizable, con alcance y criterios acordados.</p>
            <p class="scenario-benefit"><strong>Para qué le sirve:</strong> avanzar por etapas sin cambiarlo todo.</p>
            <a href="/isp-honduras#conversemos" class="campaign-cta">{ispCtaLabel} <span aria-hidden="true">↗</span></a>
          </div>
          <figure class="isp-illustration illustration-unframed">
            <img src={method.src} alt={method.alt} width={method.width} height={method.height} loading="lazy" decoding="async" />
          </figure>
        </div>
      </IspSlide>

      <IspEngineering ctaLabel={ispCtaLabel} total={total} />

      <IspSlide id="primera-entrega" index={7} total={total} label="Primera entrega y confianza" tone="dark" titleId="trust-title">
        <div class="split-slide">
          <div class="slide-copy scenario-copy">
            <h2 id="trust-title">¿Qué vas a recibir y quién te va a acompañar?</h2>
            <div class="profile">
              <img src="/mi_foto_pro.jpeg" alt="Héctor Guerra" width="96" height="96" loading="lazy" decoding="async" />
              <div><strong>Héctor Guerra</strong><p>Ingeniero Electricista Industrial<br />Tegucigalpa, Honduras</p></div>
            </div>
            <p class="scenario-problem">Trabajo directamente con vos, desde entender la necesidad hasta implementar y transferir la solución.</p>
            <p class="scenario-delivery"><strong>Antes de iniciar:</strong> acordamos entrega, alcance, inversión, dependencias y plazos.</p>
            <p class="scenario-benefit"><strong>Para qué le sirve a tu equipo:</strong> saber qué recibirá, cómo se evaluará y cómo usarlo.</p>
            <a href="/isp-honduras#conversemos" class="campaign-cta">{ispCtaLabel} <span aria-hidden="true">↗</span></a>
          </div>
          <ol class="delivery-list" aria-label="Qué recibís de una primera intervención">
            <li><span aria-hidden="true">01</span><div><h3>Una solución utilizable</h3><p>Software, integración, automatización o datos para la necesidad priorizada.</p></div></li>
            <li><span aria-hidden="true">02</span><div><h3>Criterios de aceptación</h3><p>Cómo validar la entrega y medir lo acordado.</p></div></li>
            <li><span aria-hidden="true">03</span><div><h3>Transferencia y continuidad</h3><p>Documentación, formación y acompañamiento según el alcance.</p></div></li>
          </ol>
        </div>
        <p class="slide-note">Accesos, trazabilidad y recuperación se acuerdan para los componentes entregados; no es seguridad integral ni operación de red 24/7.</p>
      </IspSlide>

      <IspSlide id="dudas" index={8} total={total} label="Antes de avanzar" titleId="faq-title">
        <div class="split-slide">
          <div class="slide-copy">
            <h2 id="faq-title">Empezar sin <span>cambiarlo todo.</span></h2>
            <p class="slide-lead">No necesitás elegir una tecnología ni contratar todo el ciclo. Empecemos por la necesidad que más importa.</p>
          </div>
          <div class="faq-list">
            {ispFaqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
          </div>
        </div>
        <a slot="footer" href="#conversemos" class="slide-text-cta">{ispCtaLabel} <span aria-hidden="true">↗</span></a>
      </IspSlide>

      <IspSlide id="conversemos" index={9} total={total} label="Tu siguiente paso" tone="muted" titleId="contact-title">
        <div class="contact-layout">
          <div class="contact-copy">
            <h2 id="contact-title">Conversemos sobre lo que querés mejorar en tu ISP.</h2>
            <p class="slide-lead">Contame qué ISP representás y qué se está trabando hoy. Revisamos si puedo ayudarte y qué primera entrega tendría sentido.</p>
          </div>
          <div class="contact-panel">
            <h3>Contame tu necesidad</h3>
            <p class="form-intro">Qué ISP representás y qué querés resolver.</p>
            <ContactForm originPath="/isp-honduras" tone="light" defaultService="otro" showService={false} detailPlaceholder="Represento a [nombre del ISP]. El problema que queremos resolver es… Hoy nos cuesta… Usamos…" submitLabel="Enviar mi consulta" />
          </div>
          <aside class="contact-followup" aria-label="Qué pasa después de escribir">
            <ol><li>Reviso el contexto.</li><li>Conversamos sobre el encaje.</li><li>Si avanzamos, acordamos una propuesta con entrega, alcance e inversión.</li></ol>
            <p class="slide-note">La consulta no es una contratación ni incluye un diagnóstico completo gratuito.</p>
          </aside>
        </div>
      </IspSlide>
    </main>
    <nav class="slide-navigation" aria-label="Navegación entre diapositivas" hidden>
      <button type="button" data-slide-direction="-1" aria-label="Diapositiva anterior" aria-disabled="true">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <span class="navigation-position" aria-label="Diapositiva actual">01 / {total}</span>
      <button type="button" data-slide-direction="1" aria-label="Diapositiva siguiente">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14m-6-6 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </nav>
    <footer class="campaign-footer"><div class="legal-inner"><p><strong>HGuerra</strong> · Inteligencia aplicada a desafíos reales.</p><div><a href="/privacidad">Privacidad</a><a href="/terminos">Términos</a></div></div></footer>
    <AnalyticsConsent enabled={true} />
    <script>
      const navigation = document.querySelector<HTMLElement>('.slide-navigation')!;
      const slides = [...document.querySelectorAll<HTMLElement>('.isp-slide')];
      const previous = navigation.querySelector<HTMLButtonElement>('[data-slide-direction="-1"]')!;
      const next = navigation.querySelector<HTMLButtonElement>('[data-slide-direction="1"]')!;
      const position = navigation.querySelector<HTMLElement>('.navigation-position')!;
      let current = 0;
      let observer: IntersectionObserver;

      function updateNavigation() {
        const marker = window.innerHeight * .25;
        current = 0;
        for (let index = 1; index < slides.length; index++) {
          if (slides[index].getBoundingClientRect().top > marker) break;
          current = index;
        }
        previous.setAttribute('aria-disabled', String(current === 0));
        next.setAttribute('aria-disabled', String(current === slides.length - 1));
        previous.setAttribute('aria-controls', slides[Math.max(0, current - 1)].id);
        next.setAttribute('aria-controls', slides[Math.min(slides.length - 1, current + 1)].id);
        position.textContent = `${String(current + 1).padStart(2, '0')} / ${slides.length}`;
      }

      function observeSlides() {
        observer?.disconnect();
        // A one-pixel band tracks the section being read, including tall slides.
        const marker = Math.round(window.innerHeight * .25);
        observer = new IntersectionObserver(updateNavigation, {
          rootMargin: `-${marker}px 0px -${window.innerHeight - marker - 1}px 0px`,
          threshold: 0
        });
        slides.forEach((slide) => observer.observe(slide));
        updateNavigation();
      }

      navigation.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('button[data-slide-direction]');
        if (!button) return;
        updateNavigation();
        const destination = current + Number(button.dataset.slideDirection);
        if (destination < 0 || destination >= slides.length) return;
        // Jump immediately so repeated presses never wait for a scroll animation.
        slides[destination].scrollIntoView({ behavior: 'instant', block: 'start' });
        updateNavigation();
      });
      window.addEventListener('resize', observeSlides);
      document.body.classList.add('has-slide-navigation');
      navigation.hidden = false;
      observeSlides();
    </script>
  </body>
</html>
