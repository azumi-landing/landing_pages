---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import IspEngineering from '../components/sections/IspEngineering.astro';
import { ispChallenges, ispFoundations, ispScenarioSteps, ispActivationSteps, ispFaqs } from '../data/ispCampaign';
import { getWhatsAppHref } from '../data/contact';
import { buildFAQSchema, buildServiceSchema } from '../data/site';

const title = 'Software a medida y datos para ISPs en Honduras | HGuerra';
const description = 'Software a medida y datos para abordar retención, facturación, coordinación, calidad y capacidad de tu ISP. Evaluemos una primera mejora con alcance e inversión acordados.';
const ctaLabel = 'Evaluar una mejora para mi ISP';
const whatsappHref = getWhatsAppHref('Hola Héctor, represento a un ISP de Honduras. Quiero conversar sobre una necesidad de nuestra operación y evaluar una primera mejora.');
---

<!doctype html>
<html lang="es" class="isp-campaign">
  <head>
    <SeoHead title={title} description={description} path="/isp-honduras"
      schemas={[buildFAQSchema(ispFaqs), buildServiceSchema({ name: 'Software, integración de datos e IA para ISPs', description, path: '/isp-honduras', areaServed: 'Honduras' })]} />
  </head>
  <body class="page-body-light">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="campaign-header">
      <div class="wrap header-inner">
        <div class="brand">
          <img src="/hg-favicon.svg" alt="" width="40" height="40" />
          <span><strong>HGuerra</strong><small>Inteligencia aplicada a desafíos reales.</small></span>
        </div>
        <a href="#conversemos" class="header-cta">{ctaLabel} <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <section class="hero section-deep" aria-labelledby="isp-title">
        <div class="wrap hero-grid">
          <div class="hero-message">
            <p class="eyebrow">Para ISPs de Honduras</p>
            <h1 id="isp-title">Protegé ingresos.<br /><span>Coordiná mejor.<br />Decidí con evidencia.</span></h1>
            <p class="hero-copy">Desarrollo o modernizo el software que tu ISP necesita y lo conecto con tus sistemas. Integro sus datos para gestionar clientes, ingresos, atención y calidad del servicio.</p>
            <a href="#conversemos" class="campaign-cta">{ctaLabel} <span aria-hidden="true">↗</span></a>
            <p class="hero-note">Contame qué está frenando a tu ISP. Revisamos cómo abordarlo y acordamos el alcance antes de iniciar.</p>
          </div>

          <figure class="overview" aria-labelledby="overview-title">
            <figcaption id="overview-title"><span class="figure-label">Software y datos al servicio del negocio</span><strong>Clientes, ingresos y servicio.<br />Una misma visión.</strong></figcaption>
            <ol class="systems">
              <li>
                <svg viewBox="0 0 120 94" fill="none" aria-hidden="true">
                  <rect x="8" y="8" width="104" height="78" rx="8" fill="white" stroke="#cbd5e1" stroke-width="2" />
                  <path d="M8 28h104" stroke="#cbd5e1" stroke-width="2" />
                  <circle cx="20" cy="18" r="2" fill="#1d4ed8" /><circle cx="28" cy="18" r="2" fill="#94a3b8" />
                  <circle cx="37" cy="49" r="9" fill="#dbeafe" stroke="#1d4ed8" stroke-width="2" />
                  <path d="M22 73c0-15 30-15 30 0M65 44h31M65 55h23M65 68h17" stroke="#1d4ed8" stroke-width="2.5" stroke-linecap="round" />
                </svg>
                <span>Ventas</span>
              </li>
              <li>
                <svg viewBox="0 0 120 94" fill="none" aria-hidden="true">
                  <rect x="24" y="13" width="72" height="73" rx="8" fill="white" stroke="#cbd5e1" stroke-width="2" />
                  <rect x="44" y="7" width="32" height="14" rx="5" fill="#dbeafe" stroke="#1d4ed8" stroke-width="2" />
                  <path d="m37 38 4 4 7-8m-11 22 4 4 7-8m-11 22 4 4 7-8M59 39h22M59 57h22M59 75h16" stroke="#1d4ed8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>Órdenes</span>
              </li>
              <li>
                <svg viewBox="0 0 120 94" fill="none" aria-hidden="true">
                  <path d="M32 62V43m56 19V43M43 21a26 26 0 0 1 34 0M51 31a14 14 0 0 1 18 0" stroke="#1d4ed8" stroke-width="2.5" stroke-linecap="round" />
                  <circle cx="60" cy="41" r="3" fill="#1d4ed8" />
                  <rect x="15" y="62" width="90" height="24" rx="7" fill="white" stroke="#cbd5e1" stroke-width="2" />
                  <path d="M28 74h18" stroke="#1d4ed8" stroke-width="2.5" stroke-linecap="round" />
                  <circle cx="76" cy="74" r="3" fill="#0891b2" /><circle cx="88" cy="74" r="3" fill="#0891b2" />
                </svg>
                <span>Servicio</span>
              </li>
            </ol>
            <svg class="connections" viewBox="0 0 480 65" preserveAspectRatio="none" fill="none" aria-hidden="true">
              <path d="M80 2v23q0 10 10 10h140q10 0 10 10v18M240 2v61M400 2v23q0 10-10 10H250q-10 0-10 10" stroke="#1d4ed8" stroke-width="2" />
              <circle cx="80" cy="3" r="3" fill="#1d4ed8" /><circle cx="240" cy="3" r="3" fill="#1d4ed8" /><circle cx="400" cy="3" r="3" fill="#1d4ed8" />
              <path d="m234 55 6 7 6-7" stroke="#1d4ed8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="shared-view">
              <svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><ellipse cx="20" cy="10" rx="13" ry="5" stroke="currentColor" stroke-width="2" /><path d="M7 10v10c0 3 6 5 13 5s13-2 13-5V10M7 20v10c0 3 6 5 13 5s13-2 13-5V20" stroke="currentColor" stroke-width="2" /></svg>
              <div><span>Software + datos conectados</span><strong>Qué priorizar y cómo actuar</strong></div>
            </div>
            <p class="overview-note">Seguir una oportunidad. Coordinar una atención. Decidir una ampliación.</p>
            <span class="illustrative-label">Esquema ilustrativo · No es un producto listo</span>
          </figure>
        </div>
        <div class="wrap hero-signature"><span>Héctor Guerra · Consultor independiente</span><span>Consultoría + implementación + acompañamiento</span></div>
      </section>

      <section class="campaign-section challenges-section" aria-labelledby="challenges-title">
        <div class="wrap">
          <div class="intro"><p class="eyebrow blue">Primero, lo que te está costando</p><h2 id="challenges-title">¿Dónde está el problema<br />que más te frena?</h2><p>Si alguna de estas situaciones te resulta familiar, podemos empezar por ella. No necesitás transformar todo tu ISP de una vez.</p></div>
          <div class="challenge-list">
            {ispChallenges.map((challenge, index) => <article class="challenge" aria-labelledby={`challenge-${challenge.id}`}>
              <header class="challenge-heading"><p class="area-label"><span aria-hidden="true">0{index + 1}</span> {challenge.area}</p><h3 id={`challenge-${challenge.id}`}>{challenge.title}</h3></header>
              <div class="challenge-content">
                <ul class="pain-list">{challenge.pains.map((pain) => <li id={`problema-${pain.id}`}><h4>{pain.title}</h4><p>{pain.text}</p></li>)}</ul>
                <div class="challenge-solution"><p class="content-label">Cómo te ayudo</p><p>{challenge.solution}</p><p class="source-context">{challenge.sources}</p><div class="decision"><strong>Para que podás decidir</strong><p>{challenge.decision}</p></div></div>
              </div>
              <div class="challenge-measurement"><div><span class="content-label">Con qué evaluar el avance</span><strong>{challenge.kpis}</strong></div><p>{challenge.measurementNote}</p></div>
            </article>)}
          </div>
          <div class="foundations"><h3>Dos bases para sostener la mejora.</h3><div class="foundation-grid">{ispFoundations.map((foundation) => <article id={`problema-${foundation.id}`}><h4>{foundation.title}</h4><p class="foundation-pain">{foundation.pain}</p><p>{foundation.solution}</p></article>)}</div></div>
          <p class="section-note">Definimos con vos los KPIs —indicadores clave de desempeño—, sus fuentes, línea base y metas. Son ejemplos de medición, no resultados garantizados ni un diagnóstico de tu ISP.</p>
        </div>
      </section>

      <section class="campaign-section example-section" aria-labelledby="example-title">
        <div class="wrap">
          <div class="example-heading">
            <div class="intro"><p class="eyebrow blue">Cómo podría funcionar / Ejemplo ilustrativo</p><h2 id="example-title">Una zona vuelve a reclamar.<br />Conectemos las decisiones.</h2></div>
            <p class="lead">Un mismo problema exige decisiones de técnica, operación, comercial y gerencia. Conecto los datos para que cada área actúe con contexto.</p>
          </div>
          <figure class="activation-example">
            <figcaption class="figure-label">Del evento técnico a una decisión de negocio</figcaption>
            <ol class="activation-flow">
              {ispScenarioSteps.map((step, index) => <li>
                <span class="step-number" aria-hidden="true">0{index + 1}</span>
                <h3>{step.title}</h3><p>{step.description}</p>
                <span class="record"><span>Qué permite decidir</span>{step.decision}</span>
              </li>)}
            </ol>
          </figure>
          <div class="measurement-brief">
            <span class="brief-label">La medición se diseña primero</span>
            <p>Acordamos qué decisión apoyar, cómo medirla y quién actuará. Eso define qué registra el software y cómo sus datos llegan al ETL, al modelo compartido y a los KPIs. Relacionar reclamos y bajas ayuda a investigar; no demuestra por sí solo una causa.</p>
          </div>
          <details class="activation-detail"><summary>Otra aplicación posible: del prospecto al servicio activo</summary><ol class="activation-flow">{ispActivationSteps.map((step, index) => <li><span class="step-number" aria-hidden="true">0{index + 1}</span><h3>{step.title}</h3><p>{step.description}</p><span class="record"><span>Dato que queda registrado</span>{step.record}</span></li>)}</ol></details>
          <div class="example-bottom"><p>No hace falta reemplazar todo. Integro lo que funciona y construyo lo que falta. Las integraciones y la frecuencia de actualización se acuerdan según tus sistemas.</p><a href="#conversemos" class="action-link">{ctaLabel} <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>

      <IspEngineering ctaLabel={ctaLabel} />

      <section class="campaign-section trust-section section-deep" aria-labelledby="trust-title">
        <div class="wrap">
          <div class="intro"><p class="eyebrow">Consultoría, implementación y acompañamiento</p><h2 id="trust-title">De la prioridad a la entrega.<br />Trabajás conmigo.</h2></div>
          <div class="trust-grid">
            <div class="profile">
              <div class="profile-heading">
                <img src="/mi_foto_pro.jpeg" alt="Héctor Guerra" width="112" height="112" loading="lazy" decoding="async" />
                <div><h3>Héctor Guerra</h3><p>Ingeniero Electricista Industrial<br />Tegucigalpa, Honduras</p></div>
              </div>
              <p>Mi experiencia conecta ingeniería de datos, software, telemetría e IA aplicada a procesos. Trabajo con vos para traducir la necesidad en una solución que se pueda usar y evaluar.</p>
              <p class="development-note">Uso agentes para asistir el desarrollo, bajo mi dirección y revisión técnica. Incorporar agentes a la operación de tu ISP es otra decisión, con permisos y controles acordados.</p>
            </div>
            <ol class="engagement">
              <li><span aria-hidden="true">01</span><div><h3>Elegir qué vale la pena resolver</h3><p>Revisamos el problema, su impacto y las fuentes disponibles. Definimos la prioridad y cómo evaluar el avance.</p></div></li>
              <li><span aria-hidden="true">02</span><div><h3>Acordar una entrega concreta</h3><p>Una aplicación, módulo o integración con criterios de aceptación. Alcance, inversión, dependencias y plazos acordados antes de iniciar.</p></div></li>
              <li><span aria-hidden="true">03</span><div><h3>Llevarla a uso y medir</h3><p>Implemento lo acordado y conecto los datos y KPIs pertinentes al alcance, con documentación y transferencia. La evolución se prioriza con evidencia.</p></div></li>
            </ol>
          </div>
          <div class="first-delivery"><h3>Qué te queda de una primera intervención</h3><dl><div><dt>Una herramienta útil</dt><dd>La aplicación, módulo o integración del proceso acordado.</dd></div><div><dt>Medición conectada</dt><dd>Registros, flujo de datos e indicadores según el alcance.</dd></div><div><dt>Capacidad de sostenerla</dt><dd>Documentación, transferencia y condiciones de acompañamiento.</dd></div></dl></div>
        </div>
      </section>

      <section id="conversemos" class="campaign-section contact-section" aria-labelledby="contact-title" tabindex="-1">
        <div class="wrap">
          <div class="intro"><p class="eyebrow blue">De un problema a una primera entrega</p><h2 id="contact-title">¿Qué problema de tu ISP<br />querés resolver primero?</h2><p>Contame qué te cuesta clientes, tiempo o capacidad. Evaluamos cómo abordarlo con software y datos, sin exigir que ya tengas elegida una tecnología.</p></div>
          <div class="contact-grid">
            <div class="contact-panel">
              <h3>Contame tu necesidad</h3>
              <p class="form-intro">Contame qué ISP representás y qué querés resolver.</p>
              <ContactForm originPath="/isp-honduras" tone="light" defaultService="otro" showService={false} detailPlaceholder="Represento a [nombre del ISP]. El problema que queremos resolver es… Hoy nos cuesta… Usamos…" submitLabel="Enviar mi consulta" />
            </div>
            <aside class="contact-context" aria-labelledby="expectations-title">
              <h3 id="expectations-title">Qué pasa después de escribir</h3>
              <ol class="expectations"><li>Reviso el problema y el impacto que compartís.</li><li>Evaluamos si puedo ayudarte y qué primera intervención tiene sentido.</li><li>Si avanzamos, acordamos una entrega, su inversión y las condiciones antes de iniciar.</li></ol>
              <p class="contact-note">La consulta abre una conversación. No es una contratación ni incluye un diagnóstico completo gratuito.</p>
              {whatsappHref !== '/contacto' && <a href={whatsappHref} class="whatsapp-link">¿Preferís WhatsApp? Escribime <span aria-hidden="true">↗</span></a>}
            </aside>
          </div>
        </div>
      </section>

      <section class="campaign-section faq-section" aria-labelledby="faq-title">
        <div class="wrap faq-grid">
          <div><p class="eyebrow blue">Antes de avanzar</p><h2 id="faq-title">Empezar sin<br />cambiarlo todo.</h2></div>
          <div class="faq-list">{ispFaqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div>
        </div>
      </section>
    </main>
    <footer class="campaign-footer"><div class="wrap footer-inner"><p><strong>HGuerra</strong> · Inteligencia aplicada a desafíos reales.</p><div><a href="/privacidad">Privacidad</a><a href="/terminos">Términos</a></div></div></footer>
    <AnalyticsConsent enabled={true} />
  </body>
</html>

<style>
  :global(html.isp-campaign) { scroll-padding-top: 1.5rem; }
  body { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  .wrap { width: min(calc(100% - 3rem), 76rem); margin-inline: auto; }
  .campaign-header { background: #020617; color: white; border-bottom: 1px solid #1e293b; }
  .campaign-header :focus-visible { outline-color: #67e8f9; }
  .header-inner, .brand, .footer-inner { display: flex; align-items: center; }
  .header-inner { justify-content: space-between; gap: 1rem; padding-block: .9rem; }
  .brand { gap: .75rem; }
  .brand strong { display: block; font-size: 1.15rem; }
  .brand small { display: block; color: #94a3b8; font-size: .75rem; }
  .header-cta { display: inline-flex; align-items: center; gap: .7rem; min-height: 48px; max-width: 16rem; font-size: .85rem; font-weight: 650; text-align: right; }
  .header-cta:hover, .whatsapp-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  h1, h2, h3, h4 { text-wrap: balance; }
  p, li { text-wrap: pretty; }
  .eyebrow { color: #67e8f9; font-size: .75rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 1.25rem; }
  .blue { color: #1d4ed8; }
  .hero { padding-top: clamp(2.5rem, 5vw, 4.5rem); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-bottom: 3.5rem; }
  h1 { font-size: clamp(2.35rem, 4.2vw, 4rem); line-height: 1.08; letter-spacing: -.045em; font-weight: 750; margin-bottom: 1.5rem; }
  h1 span { color: #67e8f9; }
  .hero-copy { max-width: 36rem; color: #cbd5e1; font-size: 1.12rem; line-height: 1.7; }
  .campaign-cta { display: inline-flex; justify-content: center; align-items: center; gap: .65rem; background: #67e8f9; color: #020617; padding: 1rem 1.4rem; border-radius: 9999px; font-size: .95rem; font-weight: 750; margin-top: 1.7rem; min-height: 52px; }
  .campaign-cta:hover { background: #a5f3fc; }
  .hero-note { max-width: 30rem; color: #94a3b8; font-size: .85rem; line-height: 1.65; margin-top: 1rem; }
  .hero-signature { display: flex; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; padding-block: 1.3rem; border-top: 1px solid #334155; color: #cbd5e1; font-size: .8rem; }
  .hero-signature span + span { color: #94a3b8; }
  .overview { color: #0f172a; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: var(--radius-panel); padding: clamp(1.25rem, 2.5vw, 2rem); box-shadow: var(--shadow-deep); }
  .figure-label { display: block; color: #475569; font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .overview figcaption > strong { display: block; font-size: clamp(1.5rem, 2.1vw, 1.9rem); line-height: 1.2; letter-spacing: -.03em; margin-top: .8rem; }
  .systems { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; margin-top: 2rem; text-align: center; }
  .systems svg { display: block; width: 100%; height: auto; }
  .systems span { display: block; font-size: .85rem; font-weight: 650; margin-top: .6rem; }
  .connections { display: block; width: 100%; height: 3.6rem; margin-top: .6rem; }
  .shared-view { display: flex; align-items: center; justify-content: center; gap: .8rem; background: #0f172a; color: white; border-radius: 1rem; padding: 1rem .75rem; }
  .shared-view svg { width: 2.5rem; flex-shrink: 0; color: #67e8f9; }
  .shared-view span, .shared-view strong { display: block; }
  .shared-view span { color: #cbd5e1; font-size: .75rem; margin-bottom: .25rem; }
  .shared-view strong { font-size: 1rem; }
  .overview-note { color: #475569; font-size: .85rem; text-align: center; line-height: 1.6; margin-top: 1rem; }
  .illustrative-label { display: block; color: #475569; font-size: .7rem; text-align: center; margin-top: 1rem; padding-top: .8rem; border-top: 1px solid #cbd5e1; }
  .campaign-section { padding-block: clamp(3.5rem, 6vw, 5.5rem); }
  h2 { font-size: clamp(2rem, 3.4vw, 3rem); font-weight: 730; line-height: 1.12; letter-spacing: -.035em; margin-bottom: 1.2rem; }
  h3 { font-size: 1.3rem; line-height: 1.3; font-weight: 700; letter-spacing: -.025em; }
  .intro { max-width: 45rem; margin-bottom: 2.5rem; }
  .intro > p:not(.eyebrow), .lead { color: #475569; font-size: 1.05rem; line-height: 1.75; }
  .challenge { border-top: 1px solid #cbd5e1; padding-block: 2rem; }
  .challenge-heading { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: 2rem; align-items: start; margin-bottom: 1.75rem; }
  .challenge-heading h3 { max-width: 44rem; font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .area-label { display: flex; align-items: center; gap: .7rem; color: #475569; font-size: .8rem; font-weight: 650; padding-top: .4rem; }
  .area-label span { color: #1d4ed8; }
  .challenge-content { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; }
  .pain-list { list-style: none; display: grid; gap: 1.5rem; }
  .pain-list h4, .foundation-grid h4 { font-size: 1.1rem; font-weight: 700; line-height: 1.4; letter-spacing: -.02em; margin-bottom: .6rem; }
  .pain-list p, .challenge-solution > p:not(.content-label):not(.source-context) { color: #475569; line-height: 1.75; font-size: .95rem; }
  .challenge-solution { border-left: 2px solid #1d4ed8; padding-left: 1.5rem; }
  .content-label { display: block; color: #1d4ed8; font-size: .7rem; line-height: 1.6; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; margin-bottom: .75rem; }
  .source-context { color: #475569; font-size: .8rem; line-height: 1.7; margin-top: 1rem; }
  .decision { border-top: 1px solid #cbd5e1; padding-top: 1rem; margin-top: 1.25rem; }
  .decision strong { font-size: .85rem; font-weight: 650; }
  .decision p { color: #475569; font-size: .9rem; line-height: 1.75; margin-top: .4rem; }
  .challenge-measurement { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: center; background: #f1f5f9; border-radius: var(--radius-card); padding: 1.25rem; margin-top: 1.5rem; }
  .challenge-measurement .content-label { color: #475569; margin-bottom: .4rem; }
  .challenge-measurement strong { display: block; color: #1d4ed8; font-size: .95rem; font-weight: 650; line-height: 1.7; }
  .challenge-measurement > p { color: #475569; font-size: .85rem; line-height: 1.75; }
  .foundations { border-top: 1px solid #cbd5e1; padding-top: 2rem; margin-top: .5rem; }
  .foundations > h3 { font-size: 1.5rem; margin-bottom: 1.5rem; }
  .foundation-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; }
  .foundation-grid article { border-top: 2px solid #0891b2; padding-top: 1.25rem; }
  .foundation-grid p { color: #475569; font-size: .9rem; line-height: 1.75; }
  .foundation-grid .foundation-pain { color: #334155; margin-bottom: .75rem; }
  .section-note { color: #475569; font-size: .85rem; line-height: 1.75; margin-top: 2rem; max-width: 62rem; }
  .example-section { background: #edf3f7; }
  .example-heading { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: end; margin-bottom: 2.5rem; }
  .example-heading .intro { margin-bottom: 0; }
  .example-heading h2 { margin-bottom: 0; }
  .activation-example { padding: 2rem; background: white; border: 1px solid #cbd5e1; border-radius: var(--radius-panel); }
  .activation-flow { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; list-style: none; margin-top: 1.5rem; }
