---
export const prerender = false;

import PageLayout from '../layouts/PageLayout.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import {
  getWhatsAppHref,
  getContactContextByPath,
  getContactServiceLabel,
  getContactServiceGuidance,
  normalizeContactService,
  normalizeContactOrigin
} from '../data/contact';
import { buildBreadcrumbSchema, buildContactPageSchema } from '../data/site';

const serviceParam = Astro.url.searchParams.get('service');
const originPath = normalizeContactOrigin(Astro.url.searchParams.get('origin') ?? '');
const derivedContext = originPath ? getContactContextByPath(originPath) : null;
const defaultService = normalizeContactService(serviceParam) || derivedContext?.service || '';
const serviceGuidance = getContactServiceGuidance(defaultService);
const originLabel = derivedContext?.originLabel ?? '';
const serviceLabel = defaultService ? getContactServiceLabel(defaultService) : 'Por definir';
const contextMessage = serviceGuidance?.contextMessage;
const expectationTitle = serviceGuidance?.expectationTitle
  ?? 'Una conversación para entender antes de proponer';
const expectationItems = serviceGuidance?.expectationItems ?? [
  'Reviso tu consulta y el contexto que compartís.',
  'Conversamos para entender el desafío y evaluar si puedo ayudarte.',
  'Si tiene sentido avanzar, acordamos alcance, entregables y condiciones antes de iniciar.'
];
const whatsappHref = getWhatsAppHref();
---

<PageLayout
  title="Contacto | Conversemos sobre tu desafío — Héctor Guerra"
  description="Contame qué necesita mejorar tu empresa. Evaluemos el siguiente paso en madurez, datos o inteligencia artificial, sin necesitar una solución predefinida."
  path="/contacto"
  bodyVariant="mixed"
  schemas={[
    buildContactPageSchema({
      path: '/contacto',
      title: 'Contacto — Héctor Guerra',
      description: 'Una conversación sobre tus desafíos en madurez, datos e inteligencia artificial.'
    }),
    buildBreadcrumbSchema([
      { name: 'Inicio', path: '/' },
      { name: 'Contacto', path: '/contacto' }
    ])
  ]}
>
  <main>
    <section class="section-shell-hero section-deep relative overflow-hidden">
      <div class="absolute inset-0 opacity-15">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.14) 1px, transparent 0); background-size: 42px 42px;"></div>
      </div>

      <div class="page-container relative">
        <div class="section-intro max-w-4xl">
          <span class="eyebrow-pill eyebrow-pill-dark mb-6">
            Contacto
          </span>
          <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight mb-6">
            Contame tu desafío.<br />Definamos el siguiente paso.
          </h1>
          <p class="text-xl text-slate-300 leading-relaxed max-w-3xl">
            No necesitás saber qué tecnología usar. Contame qué querés mejorar, qué está dificultando avanzar y qué cambio esperás conseguir.
          </p>
        </div>
      </div>
    </section>

    <section class="section-shell section-light">
      <div class="page-container grid gap-8 lg:grid-cols-[1.05fr_0.95fr] items-start">
        <section class="surface-card surface-panel p-8">
          <div class="mb-8 flex flex-wrap items-center gap-3">
            <span class="eyebrow-pill">
              Motivo inicial
            </span>
            <span class="rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700">
              {serviceLabel}
            </span>
          </div>

          {defaultService && defaultService !== 'otro' ? (
            <p class="text-slate-600 leading-relaxed mb-6">
              {contextMessage}
            </p>
          ) : (
            <p class="text-slate-600 leading-relaxed mb-6">
              Completá estos tres campos. Si todavía no está claro por dónde empezar, seleccioná «No estoy seguro». El motivo puede cambiar al conversar.
            </p>
          )}

          <ContactForm
            defaultService={defaultService}
            originPath={originPath}
            originLabel={originLabel}
            tone="light"
          />
        </section>

        <aside class="space-y-6">
          <div class="surface-soft p-8">
            <p class="section-eyebrow text-slate-500">Qué esperar</p>
            <h2 class="text-2xl font-bold text-slate-950 mb-4">{expectationTitle}</h2>
            <ul class="space-y-4 text-slate-600">
              {expectationItems.map((item, index) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-950 text-xs font-bold text-white">{index + 1}</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl border border-yellow-200 bg-yellow-50 p-6">
            <p class="text-sm font-semibold text-slate-800 mb-2">Sin presión. Sin compromiso.</p>
            <p class="text-sm text-slate-600 leading-relaxed">
              Si no puedo ayudarte o no hace falta una implementación, te lo digo. No se trata de vender tecnología innecesaria.
            </p>
          </div>

          <div class="cta-band p-8">
            <p class="section-eyebrow text-cyan-300">Canales alternos</p>
            <div class="space-y-4">
              <a
                href={whatsappHref}
                class="action-primary w-full"
              >
                <span>Abrir WhatsApp</span>
                <i class="fab fa-whatsapp text-sm"></i>
              </a>
              <a
                href="/sobre-mi"
                class="action-secondary action-secondary-dark w-full"
              >
                <span>Conocer mi experiencia y enfoque</span>
                <i class="fas fa-user-tie text-sm"></i>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </section>
  </main>
</PageLayout>
