---
import PageLayout from '../layouts/PageLayout.astro';
import ContactStrip from '../components/sections/ContactStrip.astro';
import {
  homeHeroBullets,
  homeProblemPoints,
  homeProfilePoints,
  homeTechnicalCapabilities,
  homeWorkflowSteps
} from '../data/home';
import { activeSolutions, coreService, VERIFIED_METRICS } from '../data/commercial';

const hasVerifiedMetrics = VERIFIED_METRICS.length > 0;
---

<PageLayout
  title="Héctor Guerra | Automatización y operaciones empresariales"
  description="Héctor Guerra ayuda a empresas a convertir procesos manuales, información dispersa y operaciones difíciles de controlar en sistemas simples, medibles y automatizados."
  path="/"
  image="/og-home.png"
  bodyVariant="mixed"
>
  <main aria-labelledby="home-title">
    <section id="inicio" class="section-shell-hero section-deep relative overflow-hidden">
      <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 right-[-10%] h-72 w-72 rounded-full bg-cyan-400/10 blur-3xl"></div>
        <div class="absolute bottom-0 left-[-8%] h-80 w-80 rounded-full bg-blue-500/10 blur-3xl"></div>
      </div>

      <div class="page-container relative grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 items-center">
        <div>
          <p class="inline-flex items-center rounded-full border border-blue-400/30 bg-blue-400/10 px-4 py-2 text-sm font-semibold text-blue-200 mb-6">
            Héctor Guerra · Consultor e implementador
          </p>
          <h1 id="home-title" class="max-w-4xl text-4xl md:text-6xl font-bold text-white leading-[1.05] mb-6">
            Procesos más claros. Operaciones más controladas.
          </h1>
          <p class="text-xl text-slate-300 leading-relaxed max-w-3xl mb-8">
            Ayudo a empresas a convertir procesos manuales, información dispersa y operaciones difíciles de controlar en sistemas simples, medibles y automatizados.
          </p>

          <ul class="mb-10 space-y-3">
            {homeHeroBullets.map((bullet) => (
              <li class="flex items-start gap-3 text-slate-200">
                <span class="mt-1 inline-flex h-6 w-6 items-center justify-center rounded-full bg-blue-400/15 text-sm text-blue-200" aria-hidden="true">✓</span>
                <span class="text-base md:text-lg leading-relaxed">{bullet}</span>
              </li>
            ))}
          </ul>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#automatizacion" class="action-primary text-lg home-link-focus">
              Ver Automatización
              <i class="fas fa-arrow-right text-sm" aria-hidden="true"></i>
            </a>
            <a href="#soluciones" class="action-secondary action-secondary-dark text-lg home-link-focus">
              Ver soluciones especializadas
            </a>
          </div>
        </div>

        <aside class="surface-card-dark surface-panel p-7 md:p-8 backdrop-blur-md" aria-label="Perfil profesional">
          <div class="mb-6 flex items-center gap-4">
            <div class="h-20 w-20 rounded-full overflow-hidden border-2 border-blue-400/30 shrink-0">
              <img
                src="/mi_foto_pro.jpeg"
                alt="Héctor Guerra"
                width="80"
                height="80"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="w-full h-full object-cover"
              />
            </div>
            <div>
              <p class="text-sm uppercase tracking-[0.2em] text-slate-400">HGuerra</p>
              <p class="mt-1 text-2xl font-bold text-white">De proceso a sistema</p>
            </div>
          </div>
          <p class="text-base leading-relaxed text-slate-200">
            El trabajo empieza por entender cómo fluye la operación hoy. Después definimos qué conviene ordenar, conectar o automatizar.
          </p>
        </aside>
      </div>
    </section>

    <section id="problemas" class="section-shell section-light" aria-labelledby="problems-title">
      <div class="page-container">
        <div class="section-intro section-intro-center">
          <p class="section-eyebrow justify-center text-slate-500">Problemas que ayudo a resolver</p>
          <h2 id="problems-title" class="section-title text-slate-950">
            Cuando la operación depende de demasiadas manos, archivos y mensajes.
          </h2>
          <p class="section-copy text-slate-600">
            No se trata de digitalizar por digitalizar. Se trata de dar a cada equipo una forma más clara de trabajar y decidir.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {homeProblemPoints.map((item) => (
            <article class="surface-card surface-panel p-6">
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-red-50" aria-hidden="true">
                <i class={`fas ${item.icon} text-red-600 text-lg`}></i>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">{item.title}</h3>
              <p class="text-sm leading-relaxed text-slate-600">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="automatizacion" class="section-shell section-muted" aria-labelledby="core-service-title">
      <div class="page-container grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-center">
        <div>
          <p class="section-eyebrow text-blue-700">Servicio core</p>
          <h2 id="core-service-title" class="section-title text-slate-950">{coreService.name}</h2>
          <p class="section-copy text-slate-600">{coreService.description}</p>
        </div>

        <article class="surface-card surface-panel p-7 md:p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500 mb-5">Qué puede ordenar</p>
          <ul class="grid gap-4 sm:grid-cols-2 mb-8">
            {coreService.capabilities.map((capability) => (
              <li class="flex gap-3 text-slate-700">
                <i class="fas fa-check mt-1 text-blue-600" aria-hidden="true"></i>
                <span>{capability}</span>
              </li>
            ))}
          </ul>
          <a href={coreService.path} class="action-primary home-link-focus">
            {coreService.cardCta}
            <i class="fas fa-arrow-right text-sm" aria-hidden="true"></i>
          </a>
        </article>
      </div>
    </section>

    <section id="soluciones" class="section-shell section-light" aria-labelledby="solutions-title">
      <div class="page-container">
        <div class="section-intro">
          <p class="section-eyebrow text-slate-500">Sobre la base de automatización</p>
          <h2 id="solutions-title" class="section-title text-slate-950">Soluciones especializadas</h2>
          <p class="section-copy text-slate-600">
            Soluciones para contextos operativos específicos, construidas sobre la misma capacidad de automatización de procesos.
          </p>
        </div>

        <div class="grid gap-6 [grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr))]">
          {activeSolutions.map((solution) => (
            <article class="surface-card surface-panel flex flex-col p-7 md:p-8">
              <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-950 text-blue-300" aria-hidden="true">
                <i class={`fas ${solution.icon} text-xl`}></i>
              </div>
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 mb-3">Solución especializada</p>
              <h3 class="text-2xl font-bold text-slate-950 mb-3">{solution.shortName}</h3>
              <p class="leading-relaxed text-slate-600 mb-7">{solution.description}</p>
              <a href={solution.path} class="action-link home-link-focus mt-auto">
                {solution.cardCta}
                <i class="fas fa-arrow-right text-sm" aria-hidden="true"></i>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="como-trabajo" class="section-shell section-muted" aria-labelledby="workflow-title">
      <div class="page-container">
        <div class="section-intro">
          <p class="section-eyebrow text-slate-500">Cómo trabajo</p>
          <h2 id="workflow-title" class="section-title text-slate-950">Un recorrido de tres pasos, desde el cuello de botella hasta el uso real.</h2>
          <p class="section-copy text-slate-600">
            La tecnología acompaña una decisión operativa. Por eso el proceso mantiene el problema de negocio a la vista en cada etapa.
          </p>
        </div>

        <ol class="grid gap-6 lg:grid-cols-3">
          {homeWorkflowSteps.map((step) => (
            <li class="surface-card surface-panel p-8">
              <span class="inline-flex rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white mb-6">Paso {step.step}</span>
              <h3 class="text-2xl font-bold text-slate-950 leading-tight">{step.title}</h3>
              <p class="mt-4 text-base leading-relaxed text-slate-600">{step.description}</p>
              <ul class="mt-8 space-y-3 border-t border-slate-200 pt-6">
                {step.points.map((point) => (
                  <li class="flex items-start gap-3">
                    <i class="fas fa-check mt-1 text-blue-600" aria-hidden="true"></i>
                    <span class="text-sm leading-relaxed text-slate-700">{point}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {hasVerifiedMetrics && (
      <section id="evidencia" class="section-shell section-light" aria-labelledby="evidence-title">
        <div class="page-container">
          <div class="section-intro">
            <p class="section-eyebrow text-slate-500">Evidencia verificable</p>
            <h2 id="evidence-title" class="section-title text-slate-950">Resultados con respaldo.</h2>
          </div>
          <div class="grid gap-6 md:grid-cols-3">
            {VERIFIED_METRICS.map((metric) => (
              <article class="surface-card p-6">
                <p class="text-3xl font-bold text-slate-950">{metric.value}</p>
                <p class="mt-3 leading-relaxed text-slate-600">{metric.meaning}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section id="capacidades" class="section-shell section-light" aria-labelledby="capabilities-title">
      <div class="page-container">
        <div class="section-intro section-intro-center">
          <p class="section-eyebrow justify-center text-slate-500">Capacidades técnicas</p>
          <h2 id="capabilities-title" class="section-title text-slate-950">Tecnología al servicio del proceso.</h2>
          <p class="section-copy text-slate-600">
            Selecciono las herramientas según el problema, el equipo y la forma en que la operación necesita sostenerse.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {homeTechnicalCapabilities.map((group) => (
            <article class="surface-card p-6">
              <h3 class="text-lg font-bold text-slate-900 mb-4">{group.title}</h3>
              <ul class="space-y-3">
                {group.items.map((item) => (
                  <li class="flex items-center gap-3 text-slate-600">
                    <span class="h-2 w-2 rounded-full bg-blue-500" aria-hidden="true"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="perfil" class="section-shell section-dark" aria-labelledby="profile-title">
      <div class="page-container grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-center">
        <div>
          <p class="section-eyebrow text-blue-200">Perfil profesional</p>
          <h2 id="profile-title" class="section-title text-white">Una misma conversación para proceso, datos e implementación.</h2>
        </div>
        <ul class="space-y-5">
          {homeProfilePoints.map((point) => (
            <li class="flex gap-4 text-lg leading-relaxed text-slate-200">
              <i class="fas fa-arrow-right mt-2 text-blue-300" aria-hidden="true"></i>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <ContactStrip
      service={coreService.contactService}
      originPath={coreService.path}
      ctaLabel="Contar mi desafío operativo"
      eyebrow="Conversación inicial"
      title="Contame qué parte de tu operación necesita más claridad."
      description="Revisamos el contexto, la ruta de trabajo posible y el siguiente paso que mejor se ajusta a tu situación."
    />
  </main>

  <style>
    .home-link-focus:focus-visible {
      outline: 3px solid #7dd3fc;
      outline-offset: 4px;
    }

    @media (prefers-reduced-motion: reduce) {
      .home-link-focus {
        transition: none;
      }
    }
  </style>
</PageLayout>
