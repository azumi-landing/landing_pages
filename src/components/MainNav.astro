---
import LogoHG from './LogoHG.astro';
import { mainNavLinks as links } from '../data/site';
interface Props { currentPath?: string }
const { currentPath = '/' } = Astro.props;
---
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<nav aria-label="Navegación principal" class="sticky top-0 z-50 border-b border-slate-800 bg-slate-950/95 backdrop-blur-xl">
  <div class="page-container">
    <div class="flex items-center justify-between gap-5 py-4">
      <div class="flex items-center gap-3 min-w-0">
        <LogoHG />
        <a href="/" class="min-w-0 text-white"><span class="block font-semibold">HGuerra <span class="hidden sm:inline text-slate-400 font-normal">/ Héctor Guerra</span></span><span class="block text-xs text-slate-400">Madurez · Datos · Inteligencia artificial</span></a>
      </div>
      <div class="hidden lg:flex items-center gap-2">
        {links.map((link) => <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined} class:list={['nav-link', link.href === '/contacto' && 'nav-contact']}>{link.label}</a>)}
      </div>
      <button id="main-nav-toggle" type="button" hidden class="lg:hidden h-12 w-12 shrink-0 rounded-full border border-slate-600 text-white" aria-label="Abrir navegación" aria-expanded="false" aria-controls="main-nav-mobile"><i class="fas fa-bars" aria-hidden="true"></i></button>
    </div>
    <div id="main-nav-mobile" class="lg:hidden border-t border-slate-700 pb-4 pt-3">
      {links.map((link) => <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined} class="nav-link block">{link.label}</a>)}
    </div>
  </div>
</nav>
<script>
  const toggle = document.getElementById('main-nav-toggle');
  const panel = document.getElementById('main-nav-mobile');
  if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    toggle.hidden = false;
    panel.classList.add('hidden');
    const close = () => { panel.classList.add('hidden'); toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-label', 'Abrir navegación'); };
    toggle.addEventListener('click', () => {
      const open = panel.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar navegación' : 'Abrir navegación');
    });
    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !panel.classList.contains('hidden')) { close(); toggle.focus(); } });
  }
</script>
<style>
  .nav-link { padding: .8rem 1rem; border-radius: 999px; color: #cbd5e1; font-weight: 600; font-size: .9rem; }
  .nav-link:hover, .nav-link[aria-current="page"] { color: white; background: #1e293b; }
  .nav-contact { background: white; color: #0f172a; }
  .nav-contact:hover, .nav-contact[aria-current="page"] { background: #cbd5e1; color: #0f172a; }
</style>
