---
import type { IspIllustration } from '../../data/ispCampaign';

interface Props {
  mode: 'data' | 'intelligence';
  illustration: Extract<IspIllustration, { kind: 'svg' }>;
}
const { mode, illustration } = Astro.props;
---

<figure class={`isp-illustration illustration-unframed architecture-${mode}`}>
  <img src={illustration.src} alt={illustration.alt} width={illustration.width}
    height={illustration.height} loading="lazy" decoding="async" />
</figure>
