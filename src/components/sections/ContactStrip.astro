---
import {
  buildContactHref,
  getWhatsAppHref,
  getContactContextByPath
} from '../../data/contact';
import { commercialCtas } from '../../data/commercial';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  ctaHref?: string;
  ctaLabel?: string;
  service?: string;
  originPath?: string;
  originLabel?: string;
}

const {
  eyebrow = 'El siguiente paso',
  title = 'No necesitás tener la solución. Empecemos por tu desafío.',
  description = 'Contame qué querés mejorar y qué está dificultando avanzar. Conversamos para definir si puedo ayudarte y por dónde tiene sentido empezar.',
  ctaHref,
  ctaLabel = 'Conversemos sobre tu desafío',
  service,
  originPath = '/',
  originLabel
} = Astro.props;

const defaultContext = getContactContextByPath(originPath);
const resolvedCtaHref = ctaHref ?? buildContactHref({
  service: service ?? defaultContext.service,
  originPath,
  originLabel: originLabel ?? defaultContext.originLabel
});
const whatsappHref = getWhatsAppHref();
---

<section id="contacto-general" class="section-shell section-dark">
  <div class="page-container-wide cta-band p-8 md:p-12">
    <div class="grid gap-8 lg:grid-cols-[1.25fr_0.75fr] items-center">
      <div>
        <span class="eyebrow-pill eyebrow-pill-dark mb-5">
          {eyebrow}
        </span>
        <h2 class="section-title text-white max-w-2xl">
          {title}
        </h2>
        <p class="section-copy text-slate-300 max-w-2xl">
          {description}
        </p>
      </div>

      <div class="space-y-4">
        <a
          href={resolvedCtaHref}
          class="action-primary w-full"
        >
          <span>{ctaLabel}</span>
          <i class="fas fa-paper-plane text-sm"></i>
        </a>
        <a
          href={whatsappHref}
          class="action-secondary action-secondary-dark w-full"
        >
          <span>{commercialCtas.whatsapp.label}</span>
          <i class="fab fa-whatsapp text-green-400 text-sm"></i>
        </a>
        <p class="text-sm text-slate-400">
          Trabajás directamente conmigo. El alcance y las condiciones se acuerdan antes de empezar.
        </p>
      </div>
    </div>
  </div>
</section>
