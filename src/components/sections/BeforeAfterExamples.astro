---
import type { BeforeAfterCase } from '../../types/serviceLanding';
interface Props { items: BeforeAfterCase[] }
const { items } = Astro.props;
---
<div class="grid gap-6 md:grid-cols-2">
  {items.map((item) => <article class="surface-card surface-panel p-7">
    <p class="section-eyebrow text-blue-700">Ejemplo / {item.industry}</p>
    <h3 class="text-2xl font-bold text-slate-950 mb-5">{item.title}</h3>
    <p class="text-slate-600 leading-relaxed mb-5"><strong class="block text-slate-950 mb-2">Punto de partida</strong>{item.before}</p>
    <p class="text-slate-600 leading-relaxed border-t border-slate-200 pt-5"><strong class="block text-blue-700 mb-2">Cambio posible</strong>{item.after}</p>
  </article>)}
</div>
