---
import { serviceLinks } from '../../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const relatedServices = serviceLinks
  .filter((service) => service.href !== currentPath)
  .map((service) => {
    const normalizedContent = {
      '/gestion-de-operaciones-de-campo': {
        title: 'Gestión de Operaciones de Campo',
        description: 'Coordinación, captura offline, evidencia y trazabilidad para equipos que trabajan en terreno.'
      },
      '/automatizacion-con-ia-agentica': {
        title: 'Automatización Inteligente de Procesos',
        description: 'Procesos internos ordenados con integraciones, RPA e IA bajo control humano.'
      }
    }[service.href];

    return {
      ...service,
      title: normalizedContent?.title ?? service.shortLabel,
      description: normalizedContent?.description ?? service.description
    };
  });
---

<section class="section-shell section-light">
  <div class="page-container">
    <div class="section-intro">
      <p class="section-eyebrow text-slate-500">Servicios relacionados</p>
      <h2 class="section-title text-slate-950">
        Puede que tu cuello de botella esté en la otra parte de tu operación.
      </h2>
      <p class="section-copy text-slate-600">
        Gestión de campo organiza lo que ocurre en terreno. Automatización inteligente ordena procesos internos que reciben, transforman o activan esos datos. Revisá la otra especialidad o conocé mi enfoque antes de decidir.
      </p>
    </div>

    <div class="grid items-start gap-6 lg:grid-cols-3 lg:auto-rows-fr">
      {relatedServices.map((service) => (
        <article class="surface-card surface-panel h-full p-8 flex flex-col gap-5">
          <div>
            <p class="section-eyebrow text-slate-500 mb-3">Ruta alternativa</p>
            <h3 class="text-2xl font-bold text-slate-950 mb-3">{service.title}</h3>
            <p class="text-slate-600 leading-relaxed">{service.description}</p>
          </div>
          <a
            href={service.href}
            class="action-secondary mt-auto self-start"
          >
            Explorar ruta
            <i class="fas fa-arrow-right text-xs"></i>
          </a>
        </article>
      ))}

      <aside class="surface-card surface-panel h-full p-8 text-slate-950 flex flex-col gap-5">
        <div>
          <p class="section-eyebrow text-slate-500 mb-3">Perfil profesional</p>
          <h3 class="text-2xl font-bold mb-4">Experiencia y enfoque</h3>
          <p class="text-slate-600 leading-relaxed">
            Conocé la experiencia, el criterio técnico y la forma de trabajo detrás de las dos especialidades.
          </p>
        </div>

        <a
          href="/sobre-mi"
          class="action-secondary mt-auto self-start"
        >
          Conocé mi enfoque
          <i class="fas fa-arrow-right text-xs"></i>
        </a>
      </aside>
    </div>
  </div>
</section>
