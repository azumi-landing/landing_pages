---
import { serviceLinks } from '../../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const relatedServices = serviceLinks
  .filter((service) => service.href !== currentPath)
  .map((service) => ({ ...service, title: service.label }));
---

<section class="section-shell section-light">
  <div class="page-container">
    <div class="section-intro">
      <p class="section-eyebrow text-slate-500">Capacidad y soluciones relacionadas</p>
      <h2 class="section-title text-slate-950">
         Una ruta para decidir y construir.
      </h2>
      <p class="section-copy text-slate-600">
         Conocé el enfoque de evaluación y las soluciones de consultoría, datos e inteligencia artificial.
      </p>
    </div>

    <div class="grid items-start gap-6 lg:grid-cols-2 lg:auto-rows-fr">
      {relatedServices.map((service) => (
        <article class="surface-card surface-panel h-full p-8 flex flex-col gap-5">
          <div>
            <p class="section-eyebrow text-slate-500 mb-3">Explorar</p>
            <h3 class="text-2xl font-bold text-slate-950 mb-3">{service.title}</h3>
            <p class="text-slate-600 leading-relaxed">{service.description}</p>
          </div>
          <a
            href={service.href}
            class="action-secondary mt-auto self-start"
          >
            Explorar ruta
            <i class="fas fa-arrow-right text-xs"></i>
          </a>
        </article>
      ))}

      <aside class="surface-card surface-panel h-full p-8 text-slate-950 flex flex-col gap-5">
        <div>
          <p class="section-eyebrow text-slate-500 mb-3">Perfil profesional</p>
          <h3 class="text-2xl font-bold mb-4">Experiencia y enfoque</h3>
          <p class="text-slate-600 leading-relaxed">
            Conocé la experiencia, el criterio técnico y la forma de trabajo detrás de la oferta.
          </p>
        </div>

        <a
          href="/sobre-mi"
          class="action-secondary mt-auto self-start"
        >
          Conocé mi enfoque
          <i class="fas fa-arrow-right text-xs"></i>
        </a>
      </aside>
    </div>
  </div>
</section>
