---
import type { IspIllustration, IspScenario } from '../../data/ispCampaign';

interface Props {
  area: IspScenario['id'];
  illustration: Extract<IspIllustration, { kind: 'animated-svg' }>;
}
const { area, illustration } = Astro.props;
const areaLabel = { comercial: 'Comercial', operativa: 'Operativa', tecnica: 'Técnica' }[area];
---

<figure class="isp-illustration area-scene area-scene-unframed" data-isp-animation>
  <img id={`scene-image-${area}`} src={illustration.posterSrc} alt={illustration.alt}
    width={illustration.width} height={illustration.height} loading="lazy" decoding="async"
    data-animated-src={illustration.src} data-poster-src={illustration.posterSrc} />
  <div class="scene-controls">
    <button type="button" class="animation-toggle" hidden aria-controls={`scene-image-${area}`}
      aria-label={`Pausar animación: ${areaLabel}`} data-area-label={areaLabel}>
      <svg data-animation-icon="pause" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <svg data-animation-icon="play" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
    </button>
  </div>
</figure>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-isp-animation]').forEach((scene) => {
    const image = scene.querySelector<HTMLImageElement>('img')!;
    const button = scene.querySelector<HTMLButtonElement>('button')!;
    let playing = true;
    let failed = false;

    function update() {
      if (reducedMotion.matches || failed) playing = false;
      const source = playing ? image.dataset.animatedSrc! : image.dataset.posterSrc!;
      if (image.getAttribute('src') !== source) image.src = source;
      const label = playing ? 'Pausar animación' : 'Reanudar animación';
      button.dataset.playing = String(playing);
      button.setAttribute('aria-label', `${label}: ${button.dataset.areaLabel}`);
      // Keep a focused control in place when motion preferences change.
      button.hidden = (failed || reducedMotion.matches) && document.activeElement !== button;
      button.setAttribute('aria-disabled', String(reducedMotion.matches || failed));
    }

    button.addEventListener('click', () => {
      if (reducedMotion.matches || failed) return;
      playing = !playing;
      if (playing) image.loading = 'eager';
      update();
    });
    button.addEventListener('blur', update);
    image.addEventListener('error', () => {
      failed = true;
      update();
    });
    reducedMotion.addEventListener('change', update);
    update();
  });
</script>
